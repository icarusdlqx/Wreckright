{
  "name": "wreckright",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "node tools/build-single.mjs",
    "preview:local": "node tools/local-preview.mjs start",
    "preview:status": "node tools/local-preview.mjs status",
    "preview:stop": "node tools/local-preview.mjs stop",
    "preview:restart": "node tools/local-preview.mjs restart",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "vite-node src/headless/cli.ts --",
    "verify:ui": "node tests/e2e/playthrough.mjs",
    "verify:interface": "node tests/e2e/interface-consistency.mjs",
    "verify:campaign": "node tests/e2e/campaign-release-journey.mjs",
    "verify:focus": "node tools/verify-focus.mjs",
    "verify:focus:fitting": "node tools/verify-focus.mjs fitting",
    "verify:focus:saves": "node tools/verify-focus.mjs saves",
    "verify:focus:audio": "node tools/verify-focus.mjs audio",
    "verify:focus:combat": "node tools/verify-focus.mjs combat",
    "verify:focus:campaign": "node tools/verify-focus.mjs campaign",
    "verify:worker": "wrangler deploy --dry-run",
    "verify:deploy": "node tools/verify-deployment.mjs",
    "sbom": "node tools/generate-sbom.mjs",
    "notices:check": "node tools/generate-third-party-notices.mjs --check",
    "notices:write": "node tools/generate-third-party-notices.mjs --write",
    "audit:content": "vite-node tools/content-consistency-audit.ts",
    "audit:economy": "vite-node tools/campaign-economy-audit.ts",
    "audit:balance:reported": "FACTION_AUDIT_SUITE=reported vite-node tools/faction-matchup-audit.ts",
    "audit:balance:duels": "FACTION_AUDIT_SUITE=duels vite-node tools/faction-matchup-audit.ts",
    "audit:balance:teams": "FACTION_AUDIT_SUITE=teams vite-node tools/faction-matchup-audit.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10",
    "wrangler": "4.125.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
